/**
 * Implements hook_install().
 */
function db_audit_install(): void {
  // Cuando el almacenamiento va a una conexión separada, hook_schema() sólo
  // ha creado las tablas en la conexión por defecto. Se replican allí.
  AuditStorage::ensureSchema();
}

/**
 * Implements hook_uninstall().
 */
function db_audit_uninstall(): void {
  AuditStorage::dropSchema();
  \Drupal::state()->deleteMultiple([
    'db_audit.rtt_ns',
    'db_audit.rtt_measured',
    'db_audit.rtt_samples',
    'db_audit.run_tag',
  ]);
}

/**
 * Implements hook_requirements().
 */
function db_audit_requirements(string $phase): array {
  $requirements = [];

  if ($phase !== 'runtime') {
    return $requirements;
  }

  $options = Database::getConnectionInfo('default')['default'] ?? [];
  $driver = $options['driver'] ?? '';

  // El módulo no captura nada mientras settings.php no apunte al driver
  // instrumentado; conviene que eso se vea de un vistazo.
  if ($driver !== 'auditmysql') {
    $requirements['db_audit_driver'] = [
      'title' => t('Database Audit: driver'),
      'value' => t('Inactivo (driver actual: %driver)', ['%driver' => $driver ?: t('desconocido')]),
      'description' => t('La captura de consultas no está activa. Configura el driver instrumentado en settings.php siguiendo el README del módulo.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }
  else {
    $requirements['db_audit_driver'] = [
      'title' => t('Database Audit: driver'),
      'value' => t('Activo (auditmysql)'),
      'description' => t('IMPORTANTE: mientras settings.php apunte a este driver, el módulo no se puede desinstalar ni borrar sin dejar el sitio sin arrancar.'),
      'severity' => REQUIREMENT_INFO,
    ];
  }

  // Prepares emulados: afecta al número de round-trips por consulta.
  if (isset($options['pdo'][\PDO::ATTR_EMULATE_PREPARES]) && !$options['pdo'][\PDO::ATTR_EMULATE_PREPARES]) {
    $requirements['db_audit_prepares'] = [
      'title' => t('Database Audit: prepares'),
      'value' => t('PDO::ATTR_EMULATE_PREPARES desactivado'),
      'description' => t('Cada consulta cuesta dos round-trips en lugar de uno. Con la base de datos en otra zona de disponibilidad, esto duplica el coste de red de todo el sitio.'),
      'severity' => REQUIREMENT_ERROR,
    ];
  }

  // Latencia medida.
  $rtt_ns = (int) \Drupal::state()->get('db_audit.rtt_ns', 0);
  $requirements['db_audit_rtt'] = [
    'title' => t('Database Audit: latencia a la base de datos'),
    'value' => $rtt_ns > 0
      ? t('@ms ms de RTT', ['@ms' => number_format($rtt_ns / 1e6, 3)])
      : t('Sin medir'),
    'description' => $rtt_ns > 0
      ? t('Medición usada para estimar qué parte del tiempo es red y cuánto se puede recuperar.')
      : t('Ejecuta <code>drush db-audit:rtt</code> para poder separar el tiempo de red del de ejecución.'),
    'severity' => $rtt_ns > 0 ? REQUIREMENT_OK : REQUIREMENT_WARNING,
  ];

  return $requirements;
}
